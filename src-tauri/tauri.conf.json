{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "supertonic-reader",
  "version": "0.1.0",
  "identifier": "com.tts-app.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "supertonic-reader",
        "width": 480,
        "height": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [],
    "resources": {
      "binaries/DirectML.dll": "DirectML.dll"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsi"
      }
    }
  },
  "plugins": {}
}
