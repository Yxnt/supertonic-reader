src-tauri/WixTools/

# ─── Logs ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Editor / IDE ───────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ─── OS junk ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Project-specific ───────────────────────────────────────────
# Local Claude Code config
.claude/

# Local-only scratch / test fixtures
测试/

# Generated TypeScript build info
*.tsbuildinfo

# Runtime model data downloaded at first run
